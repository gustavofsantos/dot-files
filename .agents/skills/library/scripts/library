#!/usr/bin/env bash
# library — read and write the private domain library. See ../SKILL.md.
#
#   library search [-n N] <term>...   ranked hits: id, score, flag, confidence, title — summary
#   library show [--raw] <id>         the entry, its diagram, then the state of each source (--raw: entry only)
#   library list                      every entry, one line each
#   library put <id> [--update] [--diagram FILE]
#                                     stdin = entry; validates, pins sources, stamps `verified`
#   library reverify <id>             re-pin sources and re-stamp `verified`; content unchanged
#   library check [id...]             report stale sources and broken `related` links (exit 1 if any)
#
# Library root:  ${LIBRARY_HOME:-$HOME/librarian/library}
# Diagrams live in ${WORKFLOWS_HOME:-$HOME/librarian/workflows}
set -euo pipefail

root="${LIBRARY_HOME:-$HOME/librarian/library}"
wf="${WORKFLOWS_HOME:-$HOME/librarian/workflows}"
max_body_lines=40
max_summary_chars=200
allowed_keys="title aliases tags summary confidence status verified source related diagram"

die() { echo "library: $*" >&2; exit "${2:-64}"; }

usage() { sed -n '2,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 64; }

valid_id() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "id must be lowercase letters, digits and hyphens: '$1'"; }

hash_file() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -c1-12
}

expand() { printf '%s' "${1/#\~/$HOME}"; }

entry_path() { valid_id "$1"; printf '%s/%s.md' "$root" "$1"; }

# field <file> <key>: the values of a frontmatter key, one per line.
field() {
  awk -v k="$2" '
    NR == 1 { next }
    $0 == "---" { exit }
    index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^ +/, "", v); sub(/ +$/, "", v); print v }
  ' "$1"
}

body() { awk '{ if (c < 2) { if ($0 == "---") c++; next } print }' "$1"; }

# report_one <label> <sha> <path>: one "state<TAB>label" line. state: ok | changed | missing | unpinned.
report_one() {
  if [[ -z "$2" ]]; then printf 'unpinned\t%s\n' "$1"
  elif [[ ! -f "$3" ]]; then printf 'missing\t%s\n' "$1"
  elif [[ "$(hash_file "$3")" != "$2" ]]; then printf 'changed\t%s\n' "$1"
  else printf 'ok\t%s\n' "$1"
  fi
}

# source_report <file>: the state of every source, then of the diagram if the entry has one.
source_report() {
  local line loc sha d
  while IFS= read -r line; do
    loc="${line%% *}"; sha=""
    [[ "$line" == *" sha="* ]] && sha="${line##* sha=}"
    report_one "$loc" "$sha" "$(expand "$loc")"
  done < <(field "$1" source)
  d="$(field "$1" diagram)"
  if [[ -n "$d" ]]; then
    loc="${d%% *}"; sha=""
    [[ "$d" == *" sha="* ]] && sha="${d##* sha=}"
    report_one "$wf/$loc" "$sha" "$wf/$loc"
  fi
}

# flag <file>: stale | deprecated | unchecked | ok — the one word a reader needs before trusting an entry.
flag() {
  local states status
  status="$(field "$1" status)"
  states="$(source_report "$1" | cut -f1)"
  if [[ "$status" == deprecated ]]; then echo deprecated
  elif grep -qE '^(changed|missing)$' <<<"$states"; then echo stale
  elif grep -q '^unpinned$' <<<"$states"; then echo unchecked
  else echo ok
  fi
}

# stamp: stdin entry -> stdout entry, sources pinned to the file's current hash, `verified` set to today.
stamp() {
  local n=0 in_fm=0 line v loc p
  while IFS= read -r line || [[ -n "$line" ]]; do
    n=$((n + 1))
    if ((n == 1)); then in_fm=1; printf '%s\n' "$line"; continue; fi
    if ((in_fm)); then
      if [[ "$line" == "---" ]]; then
        in_fm=0
        printf 'verified: %s\n---\n' "$(date +%F)"
        continue
      fi
      case "$line" in
        verified:*) continue ;;
        diagram:*)
          v="${line#diagram:}"; v="${v# }"; v="${v%% sha=*}"
          if [[ -f "$wf/$v" ]]; then printf 'diagram: %s sha=%s\n' "$v" "$(hash_file "$wf/$v")"
          else printf 'diagram: %s\n' "$v"
          fi
          continue ;;
        source:*)
          v="${line#source:}"; v="${v# }"; v="${v%% sha=*}"; loc="${v%% *}"; p="$(expand "$loc")"
          if [[ -f "$p" ]]; then printf 'source: %s sha=%s\n' "$loc" "$(hash_file "$p")"
          else printf 'source: %s\n' "$loc"
          fi
          continue ;;
      esac
    fi
    printf '%s\n' "$line"
  done
}

# validate <file>: prints every problem to stderr; fails if there is one.
validate() {
  local f="$1" bad=0 k key line v n
  problem() { echo "invalid entry: $*" >&2; bad=1; }

  [[ "$(head -n1 "$f")" == "---" ]] || { problem "first line must be ---"; return 1; }
  awk 'NR > 1 && $0 == "---" { f = 1 } END { exit !f }' "$f" || { problem "frontmatter is not closed with ---"; return 1; }

  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    problem "frontmatter line is not 'key: value': $line"
  done < <(awk 'NR == 1 { next } $0 == "---" { exit } $0 !~ /^[a-z]+:( |$)/' "$f")

  while IFS= read -r key; do
    [[ " $allowed_keys " == *" $key "* ]] || problem "unknown key '$key' (allowed: $allowed_keys)"
  done < <(awk 'NR == 1 { next } $0 == "---" { exit } /^[a-z]+:/ { sub(/:.*/, ""); print }' "$f")

  for k in title aliases tags summary confidence status related diagram; do
    n="$(field "$f" "$k" | wc -l | tr -d ' ')"
    ((n <= 1)) || problem "'$k' appears $n times"
  done
  for k in title summary confidence; do
    [[ -n "$(field "$f" "$k")" ]] || problem "'$k' is required"
  done

  v="$(field "$f" confidence)"
  [[ -z "$v" || "$v" =~ ^(documented|verified|inferred)$ ]] || problem "confidence must be documented, verified or inferred"
  v="$(field "$f" status)"
  [[ -z "$v" || "$v" =~ ^(current|deprecated)$ ]] || problem "status must be current or deprecated"
  v="$(field "$f" summary)"
  ((${#v} <= max_summary_chars)) || problem "summary is ${#v} chars; the limit is $max_summary_chars"

  [[ -n "$(field "$f" source)" ]] || problem "at least one 'source:' is required — no source, no entry"
  while IFS= read -r v; do
    v="${v%% sha=*}"
    [[ "$v" =~ ^[^[:space:]]+$ ]] || problem "source must be a single path or URL with no spaces or notes: '$v'"
  done < <(field "$f" source)

  v="$(field "$f" diagram)"; v="${v%% sha=*}"
  [[ -z "$v" || "$v" =~ ^[A-Za-z0-9._-]+\.mermaid$ ]] || problem "diagram must be a file name ending in .mermaid, with no directory: '$v'"

  n="$(body "$f" | wc -l | tr -d ' ')"
  ((n <= max_body_lines)) || problem "body is $n lines; the limit is $max_body_lines. Split it into entries, one concept each"

  return "$bad"
}

# validate_diagram <file>: Mermaid source only, as the workflow contract says.
validate_diagram() {
  local first
  first="$(awk 'NF && $0 !~ /^%%/ { print; exit }' "$1")"
  [[ -n "$first" ]] || { echo "invalid diagram: file is empty" >&2; return 1; }
  if grep -q '```' "$1" || [[ "$(head -n1 "$1")" == "---" ]]; then
    echo "invalid diagram: Mermaid source only — no code fence, no frontmatter, no prose" >&2; return 1
  fi
  [[ "$first" =~ ^(flowchart|graph|sequenceDiagram|stateDiagram|classDiagram|erDiagram|journey|gantt|timeline|mindmap|C4[A-Za-z]*) ]] ||
    { echo "invalid diagram: first line is not a Mermaid diagram type: $first" >&2; return 1; }
}

# names_of <file>: the id, title and aliases, lowercased, one per line.
names_of() {
  { basename "$1" .md; field "$1" title; field "$1" aliases | tr ',' '\n'; } |
    sed 's/^ *//; s/ *$//' | tr '[:upper:]' '[:lower:]' | { grep -v '^$' || true; } | sort -u
}

entries() { [[ -d "$root" ]] && find "$root" -maxdepth 1 -name '*.md' | sort || true; }

cmd_search() {
  local limit=8
  if [[ "${1:-}" == -n ]]; then limit="${2:?-n needs a number}"; shift 2; fi
  (($# > 0)) || die "search needs at least one term"
  local files; files="$(entries)"
  [[ -n "$files" ]] || { echo "library is empty: $root"; return 0; }

  local hits
  # shellcheck disable=SC2086
  hits="$(awk -v q="$(printf '%s' "$*" | tr '[:upper:]' '[:lower:]')" '
    function emit(   i, s, hay) {
      if (id == "") return
      s = 0
      for (i = 1; i <= n; i++) {
        if (index(ids, T[i])) s += 5
        else if (index(tags, T[i])) s += 3
        else if (index(sum, T[i])) s += 2
        else if (index(txt, T[i])) s += 1
      }
      if (wfl) title = title " [workflow]"
      if (s > 0) printf "%d\t%s\t%s\t%s\t%s\n", s, id, conf, title, sumraw
    }
    BEGIN { n = split(q, T, " ") }
    FNR == 1 {
      emit()
      id = FILENAME; sub(/.*\//, "", id); sub(/\.md$/, "", id)
      fm = 0; ids = tolower(id); tags = ""; sum = ""; txt = ""; title = ""; conf = ""; sumraw = ""; wfl = 0
    }
    FNR == 1 || FNR > 1 {
      if (fm < 2 && $0 == "---") { fm++; next }
      if (fm == 1) {
        if (index($0, "title:") == 1)      { title = substr($0, 8); ids = ids " " tolower(title) }
        else if (index($0, "aliases:") == 1) ids = ids " " tolower($0)
        else if (index($0, "tags:") == 1)    tags = tolower($0)
        else if (index($0, "summary:") == 1) { sumraw = substr($0, 10); sum = tolower(sumraw) }
        else if (index($0, "confidence:") == 1) conf = substr($0, 13)
        else if (index($0, "diagram:") == 1) wfl = 1
      } else if (fm == 2) txt = txt " " tolower($0)
    }
    END { emit() }
  ' $files | sort -t "$(printf '\t')" -k1,1nr -k2,2 | head -n "$limit")"

  [[ -n "$hits" ]] || { echo "no entry matches: $*"; return 0; }
  local score id conf title summary
  while IFS=$'\t' read -r score id conf title summary; do
    printf '%s\t%s\t%s\t%s\t%s — %s\n' "$id" "$score" "$(flag "$root/$id.md")" "$conf" "$title" "$summary"
  done <<<"$hits"
}

cmd_show() {
  local raw=0 f d
  if [[ "${1:-}" == --raw ]]; then raw=1; shift; fi
  f="$(entry_path "${1:?show needs an id}")"
  [[ -f "$f" ]] || die "no entry '$1'. Try: library search <term>" 1
  cat "$f"
  ((raw)) && return 0
  d="$(field "$f" diagram)"; d="${d%% *}"
  if [[ -n "$d" && -f "$wf/$d" ]]; then
    printf '\n-- diagram: %s\n' "$wf/$d"
    cat "$wf/$d"
  fi
  echo
  echo "-- flag: $(flag "$f")"
  source_report "$f" | awk -F'\t' '{ printf "-- source %s: %s\n", $1, $2 }'
}

cmd_list() {
  local f
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    printf '%s\t%s\t%s\t%s%s\n' "$(basename "$f" .md)" "$(flag "$f")" "$(field "$f" confidence)" "$(field "$f" title)" \
      "$([[ -n "$(field "$f" diagram)" ]] && echo ' [workflow]')"
  done < <(entries)
}

cmd_put() {
  local id="${1:?put needs an id}" update=0 diagram="" dest tmp mine other clash d
  shift
  while (($# > 0)); do
    case "$1" in
      --update) update=1 ;;
      --diagram) diagram="${2:?--diagram needs a file}"; shift ;;
      *) die "unknown option '$1'" ;;
    esac
    shift
  done
  dest="$(entry_path "$id")"
  if [[ -e "$dest" && $update -eq 0 ]]; then die "entry '$id' exists. Use --update to replace it, or pick another id" 1; fi
  if [[ ! -e "$dest" && $update -eq 1 ]]; then die "no entry '$id' to update" 1; fi

  tmp="$(mktemp -d)"; trap "rm -rf '$tmp'" EXIT
  cat > "$tmp/in.md"
  if [[ -n "$diagram" ]]; then
    [[ -f "$diagram" ]] || die "diagram file not found: $diagram" 1
    validate_diagram "$diagram" || exit 1
    # The entry points at the diagram stored with it, whatever it said before.
    awk -v d="$id.mermaid" '
      NR == 1 { print; fm = 1; next }
      fm && $0 == "---" { print "diagram: " d; fm = 0; print; next }
      fm && index($0, "diagram:") == 1 { next }
      { print }' "$tmp/in.md" > "$tmp/in2.md"
    mv "$tmp/in2.md" "$tmp/in.md"
  fi
  validate "$tmp/in.md" || exit 1
  if [[ -z "$diagram" ]]; then
    d="$(field "$tmp/in.md" diagram)"; d="${d%% *}"
    [[ -z "$d" || -f "$wf/$d" ]] || die "diagram '$d' is not in $wf. Pass the file with --diagram" 1
  fi

  # One concept, one entry: the new names must not already belong to another entry.
  cp "$tmp/in.md" "$tmp/$id.md"
  mine="$(names_of "$tmp/$id.md")"
  while IFS= read -r other; do
    [[ -n "$other" && "$other" != "$dest" ]] || continue
    clash="$(comm -12 <(printf '%s\n' "$mine") <(names_of "$other"))"
    [[ -z "$clash" ]] || die "'$clash' already names entry '$(basename "$other" .md)'. Update that entry instead" 1
  done < <(entries)

  mkdir -p "$root"
  if [[ -n "$diagram" ]]; then mkdir -p "$wf"; cp "$diagram" "$wf/$id.mermaid"; fi
  stamp < "$tmp/in.md" > "$tmp/out.md"
  mv "$tmp/out.md" "$dest"
  echo "$dest"
}

cmd_reverify() {
  local f tmp; f="$(entry_path "${1:?reverify needs an id}")"
  [[ -f "$f" ]] || die "no entry '$1'" 1
  tmp="$(mktemp)"
  stamp < "$f" > "$tmp" && mv "$tmp" "$f"
  echo "$f"
}

cmd_check() {
  local files=() f id rel problems=0 total=0 state loc
  if (($# > 0)); then for id in "$@"; do files+=("$(entry_path "$id")"); done
  else while IFS= read -r f; do [[ -n "$f" ]] && files+=("$f"); done < <(entries); fi

  for f in ${files[@]+"${files[@]}"}; do
    [[ -f "$f" ]] || die "no entry '$(basename "$f" .md)'" 1
    total=$((total + 1)); id="$(basename "$f" .md)"
    while IFS=$'\t' read -r state loc; do
      case "$state" in changed|missing) echo "stale  $id  $state  $loc"; problems=$((problems + 1)) ;; esac
    done < <(source_report "$f")
    while IFS= read -r rel; do
      rel="$(echo "$rel" | sed 's/^ *//; s/ *$//')"
      [[ -z "$rel" || -f "$root/$rel.md" ]] || { echo "broken-link  $id  related: $rel"; problems=$((problems + 1)); }
    done < <(field "$f" related | tr ',' '\n')
  done
  echo "$total entries, $problems problems"
  ((problems == 0)) || exit 1
}

case "${1:-}" in
  search)   shift; cmd_search "$@" ;;
  show)     shift; cmd_show "$@" ;;
  list)     shift; cmd_list "$@" ;;
  put)      shift; cmd_put "$@" ;;
  reverify) shift; cmd_reverify "$@" ;;
  check)    shift; cmd_check "$@" ;;
  *)        usage ;;
esac
