// Zed keymap: a port of the Neovim (config/nvim) + tmux (config/tmux) bindings.
// The README next to this file maps each binding to its origin and lists what
// Zed cannot reproduce.
//
// Layout model: a tmux pane is a Zed pane, a tmux window is a tab in it, and a
// shell or agent is a terminal tab in the center (prefix c), so ctrl-h/j/k/l
// moves between code and agents exactly as vim-tmux-navigator did.
//
// Order matters: a multi-key binding defined here (e.g. `ctrl-a s`) wins over a
// shorter built-in one (`ctrl-a` = increment), because user bindings load later.
[
  // ---------------------------------------------------------------------------
  // tmux: prefix ctrl-a. Unlike tmux, Zed drops a pending prefix after ~1s.
  // ---------------------------------------------------------------------------
  {
    "context": "Workspace",
    "bindings": {
      "ctrl-a s": "pane::SplitRight",
      "ctrl-a shift-s": "pane::SplitDown",
      "ctrl-a c": "workspace::NewCenterTerminal",
      "ctrl-a shift-c": ["task::Spawn", { "task_name": "claude" }],
      "ctrl-a x": "pane::CloseActiveItem",
      "ctrl-a z": "workspace::ToggleZoom",
      "ctrl-a n": "pane::ActivateNextItem",
      "ctrl-a p": "pane::ActivatePreviousItem",
      "ctrl-a 1": ["pane::ActivateItem", 0],
      "ctrl-a 2": ["pane::ActivateItem", 1],
      "ctrl-a 3": ["pane::ActivateItem", 2],
      "ctrl-a 4": ["pane::ActivateItem", 3],
      "ctrl-a 5": ["pane::ActivateItem", 4],
      "ctrl-a 6": ["pane::ActivateItem", 5],
      "ctrl-a 7": ["pane::ActivateItem", 6],
      "ctrl-a 8": ["pane::ActivateItem", 7],
      "ctrl-a 9": "pane::ActivateLastItem",
      "ctrl-a ctrl-h": "vim::ResizePaneLeft",
      "ctrl-a ctrl-j": "vim::ResizePaneDown",
      "ctrl-a ctrl-k": "vim::ResizePaneUp",
      "ctrl-a ctrl-l": "vim::ResizePaneRight",
      // tmux-sessionizer -s / tmux-sessionizer / claude-sessions
      "ctrl-a o": "projects::OpenRecent",
      "ctrl-a shift-o": ["task::Spawn", { "task_name": "project: open" }],
      "ctrl-a a": "tab_switcher::ToggleAll",
      "ctrl-a g": ["task::Spawn", { "task_name": "lazygit" }],
      "ctrl-a shift-d": ["task::Spawn", { "task_name": "lazydocker" }],
      "ctrl-a w": ["task::Spawn", { "task_name": "worklog" }],
      "ctrl-shift-left": "pane::SwapItemLeft",
      "ctrl-shift-right": "pane::SwapItemRight",
      // vim-tmux-navigator: C-\ is the last pane.
      "ctrl-\\": "workspace::ActivatePreviousPane",
      // toggleterm open_mapping
      "ctrl-t": "terminal_panel::Toggle",
    },
  },
  {
    // prefix prefix sends the prefix (bind-key C-a send-prefix)
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "ctrl-a ctrl-a": "vim::Increment",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-a ctrl-a": ["terminal::SendKeystroke", "ctrl-a"],
      "ctrl-a [": "terminal::ToggleViMode", // copy-mode
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },

  // ---------------------------------------------------------------------------
  // Pane navigation everywhere (Navigator.nvim + the tmux is_vim switch).
  // ---------------------------------------------------------------------------
  {
    "context": "VimControl && !menu || ProjectPanel || GitPanel || EmptyPane || Dock",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
    },
  },

  // ---------------------------------------------------------------------------
  // Neovim: keymaps.lua and the plugin configs. Leader is space.
  // ---------------------------------------------------------------------------
  {
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "ctrl-s": "workspace::Save",
      "ctrl-q": "pane::CloseActiveItem",
      "shift-q": null,
      "space space": "pane::AlternateFile",
      "space w s": "pane::SplitRight",
      "space w shift-s": "pane::SplitDown",
      "space shift-q": "zed::Quit",
      "space shift-w": "workspace::SaveAll",
      "space y p": "workspace::CopyRelativePath",

      // telescope
      "space o": "file_finder::Toggle",
      "space b": "tab_switcher::Toggle",
      "space e": "file_finder::Toggle",
      "space f": "buffer_search::Deploy",
      "space l": "pane::DeploySearch",
      "space h": "command_palette::Toggle",
      "space shift-t": "tab_switcher::ToggleAll",
      "f3": "pane::DeploySearch",

      // oil
      "-": "pane::RevealInProjectPanel",

      // LSP (lsp.config.lua); K is Zed's default hover
      "g r a": "editor::ToggleCodeActions",
      "g r d": "editor::GoToDefinition",
      "g r r": "editor::FindAllReferences",
      "g r i": "editor::GoToImplementation",
      "g r n": "editor::Rename",
      "g r t": "editor::GoToTypeDefinition",
      "g f": "editor::Format",

      // diagnostics
      "g shift-d": "diagnostics::Deploy",
      "g shift-k": "editor::ToggleInlineDiagnostics",
      "] d": "editor::GoToDiagnostic",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] e": ["editor::GoToDiagnostic", { "severity": { "min": "error", "max": "error" } }],
      "[ e": ["editor::GoToPreviousDiagnostic", { "severity": { "min": "error", "max": "error" } }],

      // gitsigns / diffview
      "] h": "editor::GoToHunk",
      "[ h": "editor::GoToPreviousHunk",
      "space d h p": "editor::ToggleSelectedDiffHunks",
      "space g h r": "git::Restore",
      "space g h d t": "git::Diff",
      "space d v": "git::Diff",

      // vim-test
      "space t f": ["task::Spawn", { "task_name": "test: file" }],
      "space t c": ["task::Spawn", { "task_name": "test: changed" }],
      "space t l": "task::Rerun",

      // rvw review queue (after/plugin/review.lua, bin/zed-review)
      "space r a": ["task::Spawn", { "task_name": "review: add" }],
      "space r e": ["task::Spawn", { "task_name": "review: edit" }],
      "space r d": ["task::Spawn", { "task_name": "review: withdraw" }],
      "space r o": ["task::Spawn", { "task_name": "review: list" }],
      "space r s": ["task::Spawn", { "task_name": "review: submit" }],

      // flash: s jumps by labels, S grows a syntax-node selection
      "s": "vim::HelixJumpToWord",
      "shift-s": "editor::SelectLargerSyntaxNode",
    },
  },
  {
    "context": "Editor && vim_mode == visual && !menu",
    "bindings": {
      "enter": ["task::Spawn", { "task_name": "review: add" }],
      "space r a": ["task::Spawn", { "task_name": "review: add" }],
      "space y p": "editor::CopyFileLocation",
      "space b": "git::Blame",
      "f3": "pane::DeploySearch",
      "s": "vim::HelixJumpToWord",
      "shift-s": "editor::SelectLargerSyntaxNode",
    },
  },
  {
    // The leader works before any file is open.
    "context": "EmptyPane",
    "bindings": {
      "space o": "file_finder::Toggle",
      "space e": "file_finder::Toggle",
      "space b": "tab_switcher::Toggle",
      "space l": "pane::DeploySearch",
      "space shift-t": "tab_switcher::ToggleAll",
      "-": "workspace::ToggleLeftDock",
    },
  },
  {
    // blink.cmp default preset
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-space": "editor::ShowCompletions",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "ctrl-y": "editor::ConfirmCompletion",
      "ctrl-e": "editor::Cancel",
    },
  },
  {
    // markdown ftplugin: j/k move by display line
    "context": "Editor && extension == md && vim_mode == normal && !menu",
    "bindings": {
      "j": ["vim::Down", { "display_lines": true }],
      "k": ["vim::Up", { "display_lines": true }],
    },
  },

  // ---------------------------------------------------------------------------
  // Pickers and panels: telescope / oil feel.
  // ---------------------------------------------------------------------------
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "-": "workspace::ToggleLeftDock",
      "ctrl-q": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "TabSwitcher",
    "bindings": {
      "ctrl-d": "tab_switcher::CloseSelectedItem",
    },
  },
  {
    "context": "ProjectSearchBar || ProjectSearchView",
    "bindings": {
      "escape": "project_search::ToggleFocus",
    },
  },
]
