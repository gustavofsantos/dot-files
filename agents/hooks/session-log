#!/usr/bin/env python3
"""
session-log — append structured events to ~/.agent-sessions/<id>.jsonl

Usage: session-log --harness claude|cursor --event <name>

--harness selects how the stdin payload is read (each harness's own native
hook shape). --event selects which of the three behaviors runs:
  turn_end       (Claude Stop / Cursor stop)                 -> parse transcript, append events
  subagent_start (Claude SubagentStart; no Cursor equivalent) -> create subagent dir + session_start
  subagent_stop  (Claude SubagentStop; no Cursor equivalent)  -> parse agent_transcript_path, append

Event log: ~/.agent-sessions/<session_id>.jsonl -- append-only, one JSON per
line. A special {"type":"_cursor","uuid":"..."} line is appended after each
turn to enable idempotent incremental parsing on subsequent calls.

Cursor's native "stop" payload ({status, loop_count}) carries no session or
cwd correlation, unlike Claude's Stop payload -- so turn_end logging for
Cursor is best-effort and commonly a no-op today. That is a pre-existing
limitation, not something this port introduces or fixes.
"""

import argparse
import json
import os
import subprocess
import sys
import time
from pathlib import Path

SESSIONS_DIR = Path(os.environ.get("AGENT_SESSIONS_DIR") or "").expanduser() \
    if os.environ.get("AGENT_SESSIONS_DIR") \
    else Path.home() / ".agent-sessions"


# ── helpers ────────────────────────────────────────────────────────────────────

def jget(obj, *keys, default=None):
    for k in keys:
        if isinstance(obj, dict):
            obj = obj.get(k)
        elif isinstance(obj, (list, tuple)) and isinstance(k, int):
            try:
                obj = obj[k]
            except IndexError:
                return default
        else:
            return default
        if obj is None:
            return default
    return obj


def read_cursor_uuid(log_path: Path) -> str | None:
    """Return the uuid of the last processed transcript entry, or None."""
    if not log_path.exists():
        return None
    last = None
    for line in log_path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
            if obj.get("type") == "_cursor":
                last = obj.get("uuid")
        except json.JSONDecodeError:
            continue
    return last


def last_turn_number(log_path: Path) -> int:
    """Return the highest turn number already written to the log."""
    if not log_path.exists():
        return 0
    last = 0
    for line in log_path.read_text().splitlines():
        try:
            obj = json.loads(line)
            if obj.get("type") == "turn_end":
                last = max(last, int(obj.get("turn", 0)))
        except (json.JSONDecodeError, ValueError, TypeError):
            continue
    return last


def parse_transcript(path: str) -> list[dict]:
    entries = []
    try:
        for line in Path(path).read_text().splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                entries.append(json.loads(line))
            except json.JSONDecodeError:
                continue
    except OSError:
        pass
    return entries


def entries_since(entries: list[dict], cursor_uuid: str | None) -> list[dict]:
    """Return entries after cursor_uuid in the list, or all if cursor is None."""
    if cursor_uuid is None:
        return entries
    idx = None
    for i, e in enumerate(entries):
        if e.get("uuid") == cursor_uuid:
            idx = i
            break
    if idx is None:
        return entries
    return entries[idx + 1:]


def extract_model(entries: list[dict]) -> str | None:
    for e in entries:
        if e.get("type") == "assistant":
            return jget(e, "message", "model")
    return None


def file_op(tool_name: str) -> str:
    if tool_name == "Write":
        return "write"
    return "edit"


def user_text(message: dict) -> str:
    content = message.get("content", "")
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = [c.get("text", "") for c in content if c.get("type") == "text"]
        return "\n".join(parts)
    return ""


# ── core: process a transcript into log events ─────────────────────────────────

def process_transcript(
    log_path: Path,
    transcript_path: str,
    session_id: str,
    ts: int,
    harness: str,
) -> None:
    entries = parse_transcript(transcript_path)
    if not entries:
        return

    cursor = read_cursor_uuid(log_path)
    new_entries = entries_since(entries, cursor)
    if not new_entries:
        return

    is_new = not log_path.exists()
    events: list[dict] = []

    if is_new:
        model = extract_model(entries)
        ev: dict = {
            "type": "session_start",
            "ts": ts,
            "session_id": session_id,
            "harness": harness,
        }
        if model:
            ev["model"] = model
        events.append(ev)

    turn_num = last_turn_number(log_path)
    last_uuid: str | None = None
    last_usage: dict | None = None
    last_model: str | None = None

    for entry in new_entries:
        etype = entry.get("type")
        uuid = entry.get("uuid")
        if uuid:
            last_uuid = uuid

        if etype == "user" and not entry.get("isMeta") and not entry.get("isSidechain"):
            msg = entry.get("message", {})
            text = user_text(msg)
            if text:
                turn_num += 1
                events.append({
                    "type": "message",
                    "ts": ts,
                    "turn": turn_num,
                    "role": "user",
                    "text": text[:4000],
                })

        elif etype == "assistant" and not entry.get("isSidechain"):
            msg = entry.get("message", {})
            usage = msg.get("usage")
            if usage:
                last_usage = usage
            model = msg.get("model")
            if model:
                last_model = model
            for block in msg.get("content", []):
                btype = block.get("type")
                if btype == "text":
                    text = block.get("text", "").strip()
                    if text:
                        events.append({
                            "type": "message",
                            "ts": ts,
                            "turn": turn_num,
                            "role": "assistant",
                            "text": text[:4000],
                        })
                elif btype == "tool_use" and block.get("name") in ("Write", "Edit", "NotebookEdit"):
                    inp = block.get("input", {})
                    path = inp.get("file_path") or inp.get("path", "")
                    if path:
                        events.append({
                            "type": "file_change",
                            "ts": ts,
                            "turn": turn_num,
                            "op": file_op(block["name"]),
                            "path": path,
                        })

    te: dict = {"type": "turn_end", "ts": ts, "turn": turn_num}
    if last_model:
        te["model"] = last_model
    if last_usage:
        te["tokens"] = {
            "input": last_usage.get("input_tokens", 0),
            "output": last_usage.get("output_tokens", 0),
            "cache_read": last_usage.get("cache_read_input_tokens", 0),
            "cache_write": last_usage.get("cache_creation_input_tokens", 0),
        }
    events.append(te)

    if last_uuid:
        events.append({"type": "_cursor", "uuid": last_uuid})

    _append(log_path, events)


def process_cursor_turn(
    log_path: Path,
    session_id: str,
    cwd: str,
    ts: int,
) -> None:
    """Cursor fallback: no transcript -- derive file changes from git diff."""
    is_new = not log_path.exists()
    events: list[dict] = []

    if is_new:
        events.append({
            "type": "session_start",
            "ts": ts,
            "session_id": session_id,
            "harness": "cursor",
        })

    turn_num = last_turn_number(log_path) + 1

    try:
        out = subprocess.check_output(
            ["git", "diff", "HEAD", "--name-only"],
            cwd=cwd, text=True, stderr=subprocess.DEVNULL,
        )
        for changed in out.strip().splitlines():
            changed = changed.strip()
            if changed:
                events.append({
                    "type": "file_change",
                    "ts": ts,
                    "turn": turn_num,
                    "op": "edit",
                    "path": changed,
                })
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        pass

    events.append({"type": "turn_end", "ts": ts, "turn": turn_num})
    _append(log_path, events)


def _append(log_path: Path, events: list[dict]) -> None:
    log_path.parent.mkdir(parents=True, exist_ok=True)
    with log_path.open("a") as f:
        for ev in events:
            f.write(json.dumps(ev, separators=(",", ":")) + "\n")


# ── event handlers ─────────────────────────────────────────────────────────────
# Each harness's payload is read directly, in its own native shape -- no
# envelope, no translation layer.

def handle_turn_end(harness: str, payload: dict) -> None:
    ts = int(time.time())

    if harness == "claude":
        session_id = payload.get("session_id") or os.environ.get("CLAUDE_SESSION_ID", "")
        if not session_id:
            return
        transcript_path = payload.get("transcript_path")
        if not transcript_path:
            return
        log_path = SESSIONS_DIR / f"{session_id}.jsonl"
        process_transcript(log_path, transcript_path, session_id, ts, "claude")
    else:
        session_id = payload.get("conversation_id", "")
        if not session_id:
            return
        cwd = jget(payload, "workspace_roots", 0) or ""
        if not cwd:
            return
        log_path = SESSIONS_DIR / f"{session_id}.jsonl"
        process_cursor_turn(log_path, session_id, cwd, ts)


def handle_subagent_start(payload: dict) -> None:
    session_id = payload.get("session_id") or os.environ.get("CLAUDE_SESSION_ID", "")
    if not session_id:
        return
    agent_id = payload.get("agent_id", "")
    agent_type = payload.get("agent_type", "")
    if not agent_id:
        return

    subdir = SESSIONS_DIR / session_id
    subdir.mkdir(parents=True, exist_ok=True)
    log_path = subdir / f"{agent_id}.jsonl"

    if not log_path.exists():
        ts = int(time.time())
        ev: dict = {
            "type": "session_start",
            "ts": ts,
            "session_id": agent_id,
            "harness": "claude",
        }
        if agent_type:
            ev["agent_type"] = agent_type
        with log_path.open("w") as f:
            f.write(json.dumps(ev, separators=(",", ":")) + "\n")


def handle_subagent_stop(payload: dict) -> None:
    session_id = payload.get("session_id") or os.environ.get("CLAUDE_SESSION_ID", "")
    if not session_id:
        return
    agent_id = payload.get("agent_id", "")
    agent_transcript_path = payload.get("agent_transcript_path", "")
    if not agent_id or not agent_transcript_path:
        return

    subdir = SESSIONS_DIR / session_id
    subdir.mkdir(parents=True, exist_ok=True)
    log_path = subdir / f"{agent_id}.jsonl"

    ts = int(time.time())
    process_transcript(log_path, agent_transcript_path, agent_id, ts, "claude")


# ── main ───────────────────────────────────────────────────────────────────────

def main() -> int:
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--harness", choices=["claude", "cursor"], required=True)
    parser.add_argument("--event", required=True)
    try:
        args = parser.parse_args()
    except SystemExit:
        print("session-log: usage: session-log --harness claude|cursor --event <name>", file=sys.stderr)
        return 1

    if args.event == "subagent_start" and args.harness != "claude":
        print(f"session-log: --event subagent_start has no {args.harness} implementation", file=sys.stderr)
        return 1
    if args.event == "subagent_stop" and args.harness != "claude":
        print(f"session-log: --event subagent_stop has no {args.harness} implementation", file=sys.stderr)
        return 1

    try:
        payload = json.loads(sys.stdin.read())
    except json.JSONDecodeError:
        payload = {}

    if args.event == "turn_end":
        handle_turn_end(args.harness, payload)
    elif args.event == "subagent_start":
        handle_subagent_start(payload)
    elif args.event == "subagent_stop":
        handle_subagent_stop(payload)
    else:
        print(f"session-log: unknown --event {args.event!r}", file=sys.stderr)
        return 1

    return 0


if __name__ == "__main__":
    sys.exit(main())
