#!/bin/bash

current_dir="$PWD"

# Handle --help flag
if [[ "$1" == "--help" ]] || [[ "$1" == "-h" ]]; then
    cat << 'EOF'
Usage:
  testfile <file_path> [<file_path2> ...]
  listchangedtests | testfile

Description:
  Runs tests for specified files. Supports seubarriga (Clojure), beyond (Python),
  and web (Django) projects. Accepts file paths as arguments or via stdin.

Options:
  --help, -h    Show this help message
EOF
    exit 0
fi

# Collect file paths from arguments or stdin
file_paths=()

if [ "$#" -eq 0 ]; then
    # Read from stdin if no arguments provided
    while IFS= read -r line; do
        [ -n "$line" ] && file_paths+=("$line")
    done
else
    # Use command line arguments
    file_paths=("$@")
fi

# Check if we have any files to test
if [ ${#file_paths[@]} -eq 0 ]; then
    # Exit silently if piped empty input; show usage only if invoked with arguments
    if [ "$#" -gt 0 ]; then
        echo "Usage:"
        echo "  testfile <file_path> [<file_path2> ...]"
        echo "  listchangedtests | testfile"
        exit 1
    fi
    exit 0
fi

seubarriga_tests=()

for file_path in "${file_paths[@]}"; do
    if [[ "$current_dir" == *"/Workplace/seubarriga"* ]] && [[ "$file_path" == test/* ]] && [[ "$file_path" == *.clj ]]; then
        seubarriga_tests+=("$file_path")
    fi
done

exit_code=0

# Run seubarriga tests in batch
if [ ${#seubarriga_tests[@]} -gt 0 ]; then
    test_namespaces=()
    for test_file in "${seubarriga_tests[@]}"; do
        namespace=$(echo "$test_file" | sed 's/^test\///' | sed 's/\.clj$//' | sed 's/\//\./g' | sed 's/_/-/g')
        test_namespaces+=("$namespace")
    done
    
    test_command="lein with-profile test midje ${test_namespaces[*]}"
    if ! eval "$test_command"; then
        exit_code=1
    fi
fi

exit $exit_code
