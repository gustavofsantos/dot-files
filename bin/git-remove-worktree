#!/usr/bin/env bash
# Usage: git-remove-worktree <branch>
#
# Remove the worktree that has <branch> checked out (the branch itself is
# kept). The symlinks git-add-worktree created are removed first, since git
# refuses to remove a worktree with untracked files. An empty project dir
# under the worktree home is removed too.
set -euo pipefail

if [[ $# -ne 1 || -z "$1" ]]; then
    echo "Usage: git-remove-worktree <branch>" >&2
    exit 1
fi

BRANCH="$1"
COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
REPO_DIR=$(dirname "$COMMON_DIR")

WORKTREE_PATH=$(git worktree list --porcelain | awk -v ref="refs/heads/$BRANCH" '
    /^worktree / { path = substr($0, 10) }
    $0 == "branch " ref { print path; exit }')

if [[ -z "$WORKTREE_PATH" ]]; then
    echo "Error: No worktree has branch '$BRANCH' checked out." >&2
    exit 1
fi

if [[ "$WORKTREE_PATH" == "$REPO_DIR" ]]; then
    echo "Error: '$BRANCH' is checked out in the main working tree." >&2
    exit 1
fi

for shared in .cursor .claude .agents AGENTS.md CLAUDE.local.md; do
    [[ -L "$WORKTREE_PATH/$shared" ]] && rm "$WORKTREE_PATH/$shared"
done

git worktree remove "$WORKTREE_PATH"
rmdir "$(dirname "$WORKTREE_PATH")" 2>/dev/null || true
echo "Removed worktree $WORKTREE_PATH"
