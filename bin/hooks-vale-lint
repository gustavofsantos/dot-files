#!/usr/bin/env bash
# hooks-vale-lint — PostToolUse(Edit|Write|MultiEdit) hook: lint markdown files with
# vale after every edit, feeding warning+error prose issues back to the agent
# so it can fix them inline. Suggestion-level alerts (Vocab,
# PassiveVoice, ...) are dropped — see config/vale/README.md's "Dogfood
# results" for which STE checks are error-level (unambiguous rules) versus
# suggestion-level (heuristics with real false-positive rates). warning+
# still has to be checked explicitly rather than trusting vale's own exit
# code: write-good and Readability keep warning-level checks (TooWordy,
# FleschReadingEase, ...) that vale's exit code alone would miss, since it
# only goes non-zero on error-level alerts.
#
# Usage: hooks-vale-lint --harness claude|cursor
#
# Wire for Claude (plugin hooks/hooks.json), event: PostToolUse, matcher Edit|Write|MultiEdit
# Wire for Cursor (plugin hooks/cursor.hooks.json), event: postToolUse, matcher Write
#
# Both harnesses' post-tool-use payload uses the same field names for what
# this hook needs (.cwd, .tool_input.file_path), so the parsing below is
# shared. Only the feedback channel differs: Claude reads the warning back
# from a non-zero exit + stderr; Cursor's postToolUse "cannot block tool
# execution — the tool has already completed" (its docs), so instead it
# reads a JSON {"additional_context": ...} object on stdout, printed with
# exit 0.
set -euo pipefail

HARNESS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness) HARNESS="$2"; shift 2 ;;
    *) shift ;;
  esac
done

case "$HARNESS" in
  claude|cursor) ;;
  *)
    echo "hooks-vale-lint: --harness must be 'claude' or 'cursor' (got '${HARNESS}')" >&2
    exit 1
    ;;
esac

command -v jq >/dev/null 2>&1 || exit 0
command -v vale >/dev/null 2>&1 || exit 0

input=$(cat)

cwd=$(printf '%s' "$input" | jq -r 'if (.cwd | type) == "string" and (.cwd | length) > 0 then .cwd else .workspace_roots[0] // empty end')
[ -n "$cwd" ] || exit 0
cd "$cwd" 2>/dev/null || exit 0

file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // .tool_input.path // empty')
[ -n "$file" ] || exit 0

case "$file" in
  *.md|*.markdown) ;;
  *) exit 0 ;;
esac

[ -f "$file" ] || exit 0

# `|| true`, not `|| exit 0`: vale now exits non-zero whenever it finds an
# error-level alert (the whole point of promoting STE checks to error), so
# treating a non-zero exit as "vale failed to run" would swallow exactly the
# alerts this hook exists to surface. An empty report is the real "vale
# didn't run" signal.
report=$(vale --output=JSON "$file" 2>/dev/null || true)
[ -n "$report" ] || exit 0

alerts=$(printf '%s' "$report" | jq -c '[.[][] | select(.Severity == "warning" or .Severity == "error")]' 2>/dev/null) || exit 0
count=$(printf '%s' "$alerts" | jq 'length')
[ "$count" -gt 0 ] || exit 0

message=$(
  echo "vale flagged $count issue(s) in $file:"
  printf '%s' "$alerts" | jq -r '.[] | "  \(.Line):\(.Span[0]) [\(.Severity)] \(.Check): \(.Message)"'
)

if [[ "$HARNESS" == "claude" ]]; then
  printf '%s\n' "$message" >&2
  exit 2
else
  jq -n --arg ctx "$message" '{additional_context: $ctx}'
  exit 0
fi
