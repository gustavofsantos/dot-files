#!/usr/bin/env bash
# hooks-vale-lint — PostToolUse(Edit|Write|MultiEdit) hook: lint markdown files with
# vale after every edit, feeding warning+error prose issues back to Claude
# via stderr so it can fix them inline. Suggestion-level alerts (Vocab,
# PassiveVoice, ...) are dropped — see config/vale/README.md's "Dogfood
# results" for which STE checks are error-level (unambiguous rules) versus
# suggestion-level (heuristics with real false-positive rates). warning+
# still has to be checked explicitly rather than trusting vale's own exit
# code: write-good and Readability keep warning-level checks (TooWordy,
# FleschReadingEase, ...) that vale's exit code alone would miss, since it
# only goes non-zero on error-level alerts.
#
# Usage: hooks-vale-lint --harness claude
#
# No Cursor implementation today.
set -euo pipefail

HARNESS=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --harness) HARNESS="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [[ "$HARNESS" != "claude" ]]; then
  echo "hooks-vale-lint: --harness must be 'claude' (got '${HARNESS}')" >&2
  exit 1
fi

command -v jq >/dev/null 2>&1 || exit 0
command -v vale >/dev/null 2>&1 || exit 0

input=$(cat)

cwd=$(printf '%s' "$input" | jq -r '.cwd // empty')
[ -n "$cwd" ] || exit 0
cd "$cwd" 2>/dev/null || exit 0

file=$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')
[ -n "$file" ] || exit 0

case "$file" in
  *.md|*.markdown) ;;
  *) exit 0 ;;
esac

[ -f "$file" ] || exit 0

# `|| true`, not `|| exit 0`: vale now exits non-zero whenever it finds an
# error-level alert (the whole point of promoting STE checks to error), so
# treating a non-zero exit as "vale failed to run" would swallow exactly the
# alerts this hook exists to surface. An empty report is the real "vale
# didn't run" signal.
report=$(vale --output=JSON "$file" 2>/dev/null || true)
[ -n "$report" ] || exit 0

alerts=$(printf '%s' "$report" | jq -c '[.[][] | select(.Severity == "warning" or .Severity == "error")]' 2>/dev/null) || exit 0
count=$(printf '%s' "$alerts" | jq 'length')
[ "$count" -gt 0 ] || exit 0

{
  echo "vale flagged $count issue(s) in $file:"
  printf '%s' "$alerts" | jq -r '.[] | "  \(.Line):\(.Span[0]) [\(.Severity)] \(.Check): \(.Message)"'
} >&2

exit 2
