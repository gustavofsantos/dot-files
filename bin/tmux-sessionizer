#!/usr/bin/env bash
# Usage: tmux-sessionizer [-s|--sessions-only] [<dir>]
#
# Pick a running tmux session or a project and switch to it, creating the
# session on first use. Projects come from ~/.projects through project-dirs,
# each followed by its git worktrees, so a branch is one jump away.

sessions_only=false
if [[ "$1" == "--sessions-only" || "$1" == "-s" ]]; then
    sessions_only=true
    shift
fi

if [[ $# -eq 1 ]]; then
    selected=$1
else
    _preview='if tmux has-session -t {} 2>/dev/null; then
                if [[ {} == claude-* ]]; then
                  claude-session-preview {}
                else
                  tmux list-windows -t {} -F "  #{window_index}  #{window_name}"
                fi
              elif [[ -d {} ]]; then
                ls -1 {} | head -20
              fi'

    if [[ "$sessions_only" == true ]]; then
        items=$(tmux ls -F "#{session_name}" 2>/dev/null)
    else
        items=$( (
            tmux ls -F "#{session_name}" 2>/dev/null
            "$(dirname "$(readlink -f "$0")")/project-dirs"
        ) )
    fi

    current_session=$(tmux display-message -p '#S' 2>/dev/null)
    pos=1
    if [[ -n "$current_session" ]]; then
        line_num=$(echo "$items" | grep -n -x -F "$current_session" | head -n 1 | cut -d: -f1)
        if [[ -n "$line_num" ]]; then
            pos=$line_num
        fi
    fi

    selected=$(echo "$items" | fzf --height 100% --prompt='→ ' --select-1 --exit-0 \
          --preview-window 'right:40%' \
          --preview "$_preview" \
          --bind "start:pos($pos)")
fi

if [[ -z $selected ]]; then
    exit 0
fi

# A worktree under ${WORKTREES_HOME:-~/.worktrees}/<project>/<branch> (made by
# git-add-worktree) becomes <project>-<branch>; so does the older
# <project>-worktrees/<branch> layout. Anything else is named after its dir.
generate_session_name() {
    local selected_path="$1"
    local parent_path=$(dirname "$selected_path")
    local parent_dir=$(basename "$parent_path")
    local worktrees_home="${WORKTREES_HOME:-$HOME/.worktrees}"
    local name

    if [[ "$(dirname "$parent_path")" == "${worktrees_home%/}" ]]; then
        name="${parent_dir}-$(basename "$selected_path")"
    elif [[ "$parent_dir" == *-worktrees ]]; then
        name="${parent_dir%-worktrees}-$(basename "$selected_path")"
    else
        name=$(basename "$selected_path")
    fi
    echo "$name" | tr .: __
}

selected_name=$(generate_session_name "$selected")
tmux_running=$(pgrep tmux)

if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s "$selected_name" -c "$selected"
    exit 0
fi

if ! tmux has-session -t="$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi

tmux switch-client -t "$selected_name"
