#!/usr/bin/env bash
# Usage: git-prune-worktrees
#
# Walk every linked worktree of this repo and offer to remove it, saying
# whether its branch still exists after a `git fetch --prune`.
set -uo pipefail

# Fetch latest remote state to identify merged/deleted branches
git fetch --prune

echo "Scanning for stale worktrees..."

main_repo=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")

while IFS= read -r wt; do
    [[ "$wt" == "$main_repo" ]] && continue

    branch=$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)

    # Check if the branch still exists locally or on remote
    if ! git rev-parse --verify --quiet "refs/heads/$branch" >/dev/null; then
        reason="Branch '$branch' is missing"
    else
        reason="Branch '$branch' exists"
    fi

    read -r -p "Remove worktree at $wt? ($reason) [y/N]: " confirm </dev/tty
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        # Remove the symlinks git-add-worktree created, or git refuses
        for shared in .cursor .claude .agents AGENTS.md CLAUDE.local.md; do
            [[ -L "$wt/$shared" ]] && rm "$wt/$shared"
        done

        git worktree remove "$wt" && echo "Deleted $wt"
        rmdir "$(dirname "$wt")" 2>/dev/null
    fi
done < <(git worktree list --porcelain | sed -n 's/^worktree //p')

# Cleanup git metadata for any manually deleted directories
git worktree prune
