#!/usr/bin/env bash
# Print every project directory a picker should offer, one per line.
# Shared by tmux-sessionizer and Doom Emacs (config/doom `gs/sessionizer'),
# so a tmux session and an Emacs workspace come from the same list.
set -uo pipefail

fixed=(
    "$HOME/.dot-files"
    "$HOME/.config/nvim"
    "$HOME/.config/doom"
    "$HOME/.config/ghostty"
)

parents=(
    "$HOME/Projects"
    "$HOME/Workplace"
    "$HOME/Workplace/seubarriga-worktrees"
    "$HOME/Workplace/backend-services/applications"
)

for dir in "${fixed[@]}"; do
    [[ -d "$dir" ]] && echo "$dir"
done

for parent in "${parents[@]}"; do
    find "$parent" -mindepth 1 -maxdepth 1 -type d 2>/dev/null
done

exit 0
