#!/usr/bin/env bash
# Print every project directory a picker should offer, one per line.
# Shared by tmux-sessionizer and Doom Emacs (config/doom `gs/sessionizer'),
# so a tmux session and an Emacs workspace come from the same list.
#
# The projects come from ${PROJECTS_FILE:-~/.projects}: one directory per
# line, `~` expanded, blank lines and `#` comments ignored, and glob patterns
# (`~/Workplace/*`) expanded to the directories they match. A project that is
# a git repo is followed by its linked worktrees, so each branch checked out
# with git-add-worktree is one jump away.
set -uo pipefail

projects_file="${PROJECTS_FILE:-$HOME/.projects}"
[[ -r "$projects_file" ]] || exit 0

shopt -s nullglob

emit() {
    local dir="$1" wt
    [[ -d "$dir" ]] || return 0
    dir=$(cd "$dir" && pwd -P)
    echo "$dir"
    git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    # Linked worktrees only: the main tree is $dir itself, and a project
    # inside a monorepo would otherwise list the monorepo's root.
    git -C "$dir" worktree list --porcelain 2>/dev/null |
        sed -n 's/^worktree //p' | tail -n +2 |
        while IFS= read -r wt; do
            [[ -d "$wt" && "$wt" != "$dir" ]] && echo "$wt"
        done
}

while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    [[ "$line" == "~"* ]] && line="$HOME${line#\~}"

    if [[ "$line" == *[\*\?\[]* ]]; then
        for match in $line; do emit "$match"; done
    else
        emit "$line"
    fi
done < "$projects_file" | awk '!seen[$0]++'

exit 0
