{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "hooks-session-track --harness cursor"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "hooks-session-track --harness cursor"
      }
    ],
    "stop": [
      {
        "command": "hooks-session-log --harness cursor --event turn_end"
      },
      {
        "command": "hooks-engineering-autocommit --harness cursor"
      },
      {
        "command": "hooks-checks-snapshot --harness cursor"
      }
    ]
  }
}
